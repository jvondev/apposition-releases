# Google GenAI API Key (Get this from Google AI Studio)
GOOGLE_API_KEY=your_google_api_key_here

# Telegram Configuration (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# The Chat ID where the bot should send leads (Can be a user ID, group ID, or channel ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
