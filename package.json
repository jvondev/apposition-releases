{
  "name": "apposition",
  "version": "1.1.0",
  "description": "A smart digital workspace to organize web apps, accounts, and tasks in one place.",
  "main": "./out/main/index.js",
  "author": "jvondev",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test:e2e": "playwright test",
    "db:reset": "node scripts/reset-db.js",
    "ship": "node scripts/ship.js",
    "sync:refs": "node scripts/apposition-references.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:gatekeep": "cross-env FORCE_GATEKEEP=1 electron-vite dev",
    "dev:web": "pnpm --filter web dev",
    "build": "npm run typecheck && electron-vite build",
    "rebuild": "electron-rebuild",
    "build:win": "npm run rebuild && npm run build && electron-builder --win -c.npmRebuild=false",
    "build:mac": "npm run rebuild && npm run build && electron-builder --mac -c.npmRebuild=false",
    "build:linux": "npm run rebuild && npm run build && electron-builder --linux -c.npmRebuild=false"
  },
  "dependencies": {
    "@apposition/ui": "workspace:*",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^11.1.2",
    "bindings": "^1.5.0",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "lucide-solid": "^0.473.0",
    "solid-js": "^1.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "cross-env": "^10.1.0",
    "electron": "^34.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "jimp": "^1.6.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.10.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
